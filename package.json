{
  "name": "clip-demo",
  "version": "1.0.0",
  "description": "剪藏 - 信息检索与剪藏系统",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "build:jar": "cd backend && mvn clean package -DskipTests",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.example.clip-demo",
    "productName": "剪藏",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/target/clip-demo-0.0.1-SNAPSHOT.jar",
        "to": "backend/clip-demo-0.0.1-SNAPSHOT.jar"
      },
      {
        "from": "frontend",
        "to": "frontend",
        "filter": ["index.html", "public/**/*"]
      },
      {
        "from": "jre",
        "to": "jre",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signingHashAlgorithms": ["sha256"],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clip",
      "packElevateHelper": false,
      "differentialPackage": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "finalhandler": "^1.2.0",
    "js-yaml": "^4.1.0",
    "serve-static": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
