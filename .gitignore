# 剪藏Demo项目Git忽略文件配置
# 参考阿里巴巴Java开发手册，添加详细注释

# JDK 运行时目录（超大文件）
jdk/
jre/
win-unpacked/

# 编译生成的class文件
*.class

# 日志文件
*.log

# BlueJ文件
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# 打包文件
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# 虚拟机崩溃日志
hs_err_pid*
replay_pid*

# Maven构建目录和文件
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE配置文件
.idea/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project

# 应用配置文件（本地配置，不提交到版本库）
application.yml
application.properties
application-dev.yml
application-prod.yml

# 存储目录（包含用户数据，不提交到版本库）
clip-storage/
clip-organized/

# Node.js模块目录
node_modules/

# 构建输出目录
dist/
dist-electron/
build/

# Electron构建输出
out/
release/

# 嵌入式JRE（太大，使用prepare-jre.bat下载）
jre/

# 操作系统文件
.DS_Store
Thumbs.db

# Windows 设备名误创建的空文件（git 幽灵条目）
nul

# Obsidian配置目录
.obsidian/
